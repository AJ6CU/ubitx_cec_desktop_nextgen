{
    "_comment": [
        "The SDR programs this application can drive, and what is true of each.",
        "",
        "ONE ENTRY PER WAY OF DRIVING A PROGRAM, not per program. A program",
        "that can be driven two ways gets two entries with the same install",
        "paths and different protocols -- a second interface is a second",
        "entry, never a flag.",
        "",
        "SDRangel is driven over its REST API only. Its rigctl server plugin",
        "answers frequency and mode and nothing else, and neither the plugin",
        "nor its running state survives a restart of SDRangel, so it was",
        "removed rather than kept as a second, lesser entry.",
        "",
        "TO ADD OR CHANGE ONE, do not edit this file -- it is replaced when the",
        "application is updated. Put your own entries in:",
        "",
        "    ~/.ubitx_cec_desktop/sdr_programs.json",
        "",
        "which is merged over this one, ENTRY BY ENTRY: yours override or add",
        "to these, and programs added here later still reach you. Same shape as",
        "below; see sdr_profiles.py for what each field means.",
        "",
        "protocol says which transport code drives it -- 'rigctl' or 'rest'.",
        "It names the transport; it does not describe it. Everything about how",
        "a protocol works lives in code. A 'rest' entry's modes are the rig's",
        "own names: SDRangel has no mode names, and the transport turns each",
        "into a demodulator and bandwidth itself."
    ],

    "sdr++": {
        "name": "SDR++",
        "app_name": "SDR++",
        "protocol": "rigctl",
        "port": 4532,
        "modes": {"LSB": "LSB", "USB": "USB", "CWL": "CW", "CWU": "CW"},
        "ambiguous_modes": {"CW": "cw"},
        "start": "\\start",
        "stop": "\\stop",
        "self_describing": false,
        "known_missing": ["signal", "volume", "squelch", "mute"],
        "process_names": ["sdrpp", "sdrpp.exe", "sdr++"],
        "paths": {
            "darwin": ["/Applications/SDR++.app/Contents/MacOS/sdrpp"],
            "win32": ["C:\\SDRPlusPlus\\sdrpp.exe", "C:\\Program Files\\SDR++\\sdrpp.exe"],
            "linux": ["sdrpp"]
        },
        "arguments": {"win32": ["--autostart"], "linux": ["--autostart"]}
    },

    "gqrx": {
        "name": "Gqrx",
        "app_name": "Gqrx",
        "launch_as_application": true,
        "never_force_quit": true,
        "protocol": "rigctl",
        "port": 7356,
        "modes": {"LSB": "LSB", "USB": "USB", "CWL": "CWL", "CWU": "CWU"},
        "ambiguous_modes": {"CW": "cw"},
        "start": "U DSP 1",
        "stop": "U DSP 0",
        "self_describing": true,
        "known_present": ["filter"],
        "volume_range": [-80.0, 50.0],
        "squelch_range": [-150.0, 0.0],
        "squelch_unit": "dBFS",
        "process_names": ["gqrx", "gqrx.exe"],
        "paths": {
            "darwin": ["/Applications/Gqrx.app/Contents/MacOS/gqrx"],
            "win32": ["C:\\Program Files\\gqrx\\gqrx.exe"],
            "linux": ["gqrx"]
        }
    },

    "sdrangel": {
        "name": "SDRangel",
        "protocol": "rest",
        "port": 8091,
        "volume_range": [-10.0, 40.0],
        "modes": {"LSB": "LSB", "USB": "USB", "CWL": "CWL", "CWU": "CWU"},
        "app_name": "SDRangel",
        "launch_as_application": true,
        "process_names": ["sdrangel", "sdrangel.exe", "sdrangelsrv"],
        "paths": {
            "darwin": ["/Applications/SDRangel.app/Contents/MacOS/sdrangel"],
            "win32": ["C:\\Program Files\\SDRangel\\sdrangel.exe"],
            "linux": ["sdrangel"]
        }
    },

    "rigctld": {
        "name": "rigctld (Hamlib)",
        "protocol": "rigctl",
        "port": 4532,
        "modes": {"LSB": "LSB", "USB": "USB", "CWL": "CWR", "CWU": "CW"},
        "self_describing": true,
        "volume_range": [0.0, 1.0],
        "squelch_range": [0.0, 1.0],
        "process_names": ["rigctld", "rigctld.exe"],
        "paths": {
            "darwin": ["rigctld"],
            "win32": ["rigctld.exe"],
            "linux": ["rigctld"]
        },
        "needs_command_line": true
    }
}
